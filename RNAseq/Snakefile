# Snakefile
# Bulk RNA-seq pipeline with Snakemake

import pandas as pd
import os

# 加载配置文件
configfile: "config/config.yaml"

# 加载样本信息
SAMPLES_FILE = config.get("samples_file", "config/samples.tsv")
samples = pd.read_csv(SAMPLES_FILE, sep="\t").set_index("sample", drop=False)

# 定义样本列表
SAMPLES = samples["sample"].tolist()

# 定义对比组
CONTRASTS = config["contrasts"]

# 定义参考基因组路径
GENOME_DIR = config["genome"]["alignment_index"]
GTF_FILE = config["genome"]["gtf"]

def fastq_path(column):
    return lambda wildcards: samples.loc[wildcards.sample, column]

# 所有最终输出文件
rule all:
    input:
        # 比对统计汇总
        "results/qc/alignment_stats.tsv",
        # 表达矩阵
        "results/expression/counts_matrix.csv",
        "results/expression/tpm_matrix.csv",
        # 差异分析结果
        expand("results/deseq2/{contrast}_DE_results.csv", contrast=CONTRASTS),
        expand("results/deseq2/{contrast}_normalized_counts.csv", contrast=CONTRASTS),
        # 可视化
        expand("results/figures/{contrast}_volcano.pdf", contrast=CONTRASTS),
        expand("results/figures/{contrast}_heatmap.pdf", contrast=CONTRASTS),
        expand("results/figures/{contrast}_pca.pdf", contrast=CONTRASTS),
        # 富集分析
        expand("results/enrichment/{contrast}_GO_results.csv", contrast=CONTRASTS),
        expand("results/enrichment/{contrast}_KEGG_results.csv", contrast=CONTRASTS),
        # 最终报告
        "results/report.html"

# 1. 质量控制 - Fastp
rule fastp:
    input:
        fq1 = fastq_path("fastq1"),
        fq2 = fastq_path("fastq2")
    output:
        cleanq1 = "results/qc/fastp/{sample}_R1_clean.fastq.gz",
        cleanq2 = "results/qc/fastp/{sample}_R2_clean.fastq.gz",
        report_html = "results/qc/fastp/reports/{sample}_fastp.html",
        report_json = "results/qc/fastp/reports/{sample}_fastp.json"
    log:
        "logs/fastp/{sample}.log"
    conda:
        "envs/fastp.yaml"
    threads: 4
    shell:
        """
        fastp -i {input.fq1} -I {input.fq2} \
            -o {output.cleanq1} -O {output.cleanq2} \
            --detect_adapter_for_pe \
            --cut_window_size 4 \
            --cut_mean_quality 20 \
            --length_required 36 \
            --correction \
            --thread {threads} \
            -h {output.report_html} \
            -j {output.report_json} \
            2> {log}
        """

# 2. Hisat2比对
rule hisat2_alignment:
    input:
        fq1 = "results/qc/fastp/{sample}_R1_clean.fastq.gz",
        fq2 = "results/qc/fastp/{sample}_R2_clean.fastq.gz"
    output:
        bam = "results/alignment/{sample}.sorted.bam",
        bai = "results/alignment/{sample}.sorted.bam.bai",
        summary = "results/alignment/{sample}_hisat2_summary.txt"
    params:
        genome_dir = GENOME_DIR,
        out_prefix = "results/alignment/{sample}/"
    log:
        "logs/alignment/{sample}.log"
    threads: 8
    conda:
        "envs/hisat2.yaml"
    shell:
        """
        hisat2 -x {params.genome_dir} \
               -1 {input.fq1} \
               -2 {input.fq2} \
               --threads {threads} \
               --summary-file {output.summary} \
               --max-intronlen 200000 \
               --min-intronlen 20 \
               --no-unal \
               2> {log} | \
            samtools view -bS -@ {threads} - | \
            samtools sort -@ {threads} -o {output.bam} -
        
        samtools index {output.bam}
        """


# 3. featureCounts定量
rule featurecounts:
    input:
        expand("results/alignment/{sample}.sorted.bam", sample=SAMPLES)
    output:
        counts = "results/expression/counts_raw.txt",
        summary = "results/expression/counts_raw.txt.summary"
    log:
        "logs/featurecounts/featurecounts.log"
    params:
        gtf = GTF_FILE,
        threads = 8
    threads: 8
    conda:
        "envs/featurecounts.yaml"
    shell:
        """
        featureCounts -T {threads} \
                       -a {params.gtf} \
                       -g gene_id \
                       -o {output.counts} \
                       -p \
                       -s 2 \
                       --countReadPairs \
                       {input} 2> {log}
        """

# 7. 处理counts矩阵（添加基因名称等）
rule process_counts:
    input:
        "results/expression/counts_raw.txt"
    output:
        counts_csv = "results/expression/counts_matrix.csv",
        tpm_csv = "results/expression/tpm_matrix.csv"
    script:
        "scripts/process_counts.py"

# 8. DESeq2差异分析
rule deseq2_analysis:
    input:
        counts = "results/expression/counts_matrix.csv",
        samples_tsv = SAMPLES_FILE
    output:
        de_results = expand("results/deseq2/{contrast}_DE_results.csv", contrast=CONTRASTS),
        norm_counts = expand("results/deseq2/{contrast}_normalized_counts.csv", contrast=CONTRASTS),
        all_norm_counts = "results/deseq2/all_samples_normalized_counts.csv",
        rdata = "results/deseq2/deseq2_object.RData"
    params:
        contrasts = CONTRASTS
    script:
        "scripts/deseq2_analysis.R"

# 9. 火山图
rule volcano_plot:
    input:
        "results/deseq2/{contrast}_DE_results.csv"
    output:
        "results/figures/{contrast}_volcano.pdf"
    params:
        contrast = "{contrast}"
    script:
        "scripts/volcano_plot.R"

# 10. 热图
rule heatmap:
    input:
        norm_counts = "results/deseq2/{contrast}_normalized_counts.csv",
        de_results = "results/deseq2/{contrast}_DE_results.csv",
        samples_tsv = SAMPLES_FILE
    output:
        "results/figures/{contrast}_heatmap.pdf"
    params:
        contrast = "{contrast}"
    script:
        "scripts/heatmap.R"

# 11. PCA图
rule pca_plot:
    input:
        norm_counts = "results/deseq2/all_samples_normalized_counts.csv",
        samples_tsv = SAMPLES_FILE
    output:
        "results/figures/{contrast}_pca.pdf"
    script:
        "scripts/pca_plot.R"

# 12. 富集分析
rule enrichment_analysis:
    input:
        "results/deseq2/{contrast}_DE_results.csv"
    output:
        go = "results/enrichment/{contrast}_GO_results.csv",
        kegg = "results/enrichment/{contrast}_KEGG_results.csv"
    params:
        contrast = "{contrast}"
    script:
        "scripts/enrichment_analysis.R"

# 13. 生成最终报告
rule alignment_stats:
    input:
        expand("results/alignment/{sample}_hisat2_summary.txt", sample=SAMPLES)
    output:
        "results/qc/alignment_stats.tsv"
    script:
        "scripts/collect_alignment_stats.py"

rule multiqc:
    input:
        fastp = expand("results/qc/fastp/reports/{sample}_fastp.json", sample=SAMPLES),
        alignment = expand("results/alignment/{sample}_hisat2_summary.txt", sample=SAMPLES)
    output:
        "results/qc/multiqc_report.html"
    conda:
        "envs/multiqc.yaml"
    shell:
        "multiqc --force --outdir results/qc --filename multiqc_report.html {input}"

rule generate_report:
    input:
        multiqc = "results/qc/multiqc_report.html",
        alignment_stats = "results/qc/alignment_stats.tsv",
        de_results = expand("results/deseq2/{contrast}_DE_results.csv", contrast=CONTRASTS)
    output:
        "results/report.html"
    script:
        "scripts/generate_report.py"
